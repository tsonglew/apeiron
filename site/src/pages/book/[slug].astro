---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const chapters = (await getCollection("book")).sort(
    (a, b) => a.data.order - b.data.order
  );
  return chapters
    .filter((c) => c.data.order > 0)
    .map((entry, index) => ({
      params: { slug: entry.id },
      props: {
        entry,
        prev: chapters[index - 1]?.data.order > 0 ? chapters[index - 1] : null,
        next:
          chapters[index + 1]?.data.order > 0 ? chapters[index + 1] : null,
      },
    }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <p class="chapter-label">
    第 {entry.data.order} 章{entry.data.date && ` · ${entry.data.date}`}
  </p>
  <article class="prose">
    <Content />
  </article>
  <nav class="chapter-nav">
    {
      prev && (
        <a class="nav-prev" href={base + "book/" + prev.id + "/"}>
          ← {prev.data.title}
        </a>
      )
    }
    {
      next ? (
        <a class="nav-next" href={base + "book/" + next.id + "/"}>
          {next.data.title} →
        </a>
      ) : (
        <a class="nav-next" href={base}>
          回到目录 →
        </a>
      )
    }
  </nav>
</BaseLayout>
