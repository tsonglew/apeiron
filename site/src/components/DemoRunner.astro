---
// 可交互演示组件：浏览器里真实运行 apeiron 的 WASM 核心（演示即真相）。
// 视觉：深色"信号仪器"面板——事件流=逻辑分析仪时间轴，日志=树，消息=角色流。
// 不依赖任何前端框架：纯 DOM + 一行 client script，加载 public/apeiron-demo.wasm。
interface Props {
  title?: string
  autorun?: boolean
}
const { title = '交互演示：真实 harness 核心', autorun = false } = Astro.props
const autorunAttr = autorun ? '' : 'data-manual'
---

<section class="apeiron-demo" aria-label={title}>
  <header class="hd">
    <div class="hd-t">
      <div class="hd-title">{title}</div>
      <div class="hd-sub">
        编译自 Zig 的 WASM 真身：追加 user entry → LLM（脚本化 provider）→ echo 工具 → 回喂 → assistant
      </div>
    </div>
    <div id="wasm-status" class="status" data-ok="0"><i class="led" />…加载 wasm</div>
  </header>

  <div class="controls">
    <div class="inputwrap">
      <span class="prompt">msgs.log &gt; _</span>
      <textarea id="demo-input" rows="1" placeholder="输入消息…" spellcheck="false">你好，apeiron</textarea>
    </div>
    <div class="actions">
      <button id="demo-run" type="button" class="primary">
        <span class="tri">▶</span> 运行一个 turn
      </button>
      <button id="demo-resume" type="button" class="ghost">↻ 演示恢复</button>
      <button id="demo-reset" type="button" class="ghost">重置</button>
    </div>
  </div>

  <div class="grid">
    <div class="col">
      <div class="col-h"><i class="tick t-evt" />事件流 · boundary</div>
      <ol id="demo-events" class="list evt">
        <li class="empty">等待运行（点 ▶）</li>
      </ol>
    </div>
    <div class="col">
      <div class="col-h"><i class="tick t-log" />会话日志 · entries</div>
      <ol id="demo-entries" class="list log">
        <li class="empty">等待运行（点 ▶）</li>
      </ol>
    </div>
    <div class="col">
      <div class="col-h"><i class="tick t-msg" />消息 · messages</div>
      <ol id="demo-messages" class="list msg">
        <li class="empty">等待运行（点 ▶）</li>
      </ol>
    </div>
  </div>

  <details class="raw" {autorunAttr}>
    <summary>原始结果 JSON · trace 实时形态</summary>
    <pre id="demo-raw">—</pre>
  </details>

  <footer class="ft">
    <span>单写者 · (session_id, seq) CAS · model-visible == logged</span>
    <span class="ft-dots">✓ ✓ ✓</span>
  </footer>
</section>

<script>
  // 注意：客户端脚本里 import.meta.env.BASE_URL 可能无尾斜杠（如 "/apeiron"），需规范化
  const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
  const $ = (id) => document.getElementById(id)
  let ex = null // wasm exports

  function setStatus(text, ok, busy) {
    const el = $('wasm-status')
    el.textContent = text
    el.dataset.ok = ok ? '1' : '0'
    el.classList.toggle('busy', !!busy)
  }

  async function loadWasm() {
    try {
      const res = await fetch(`${base}/apeiron-demo.wasm`)
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      const bytes = await res.arrayBuffer()
      const { instance } = await WebAssembly.instantiate(bytes, {})
      ex = instance.exports
      ex.demo_init()
      setStatus('wasm 就绪 · 220 KB', true, false)
      if (!document.querySelector('.apeiron-demo').hasAttribute('data-manual')) autoRun()
    } catch (err) {
      setStatus(`加载失败：${err.message}`, false, false)
      console.error(err)
    }
  }

  function autoRun() {
    if (ex && $('demo-input').value.trim()) {
      setTimeout(runTurn, 350)
    }
  }

  function writeInput(text) {
    const enc = new TextEncoder()
    const bytes = enc.encode(text)
    const ptr = ex.demo_input_ptr()
    new Uint8Array(ex.memory.buffer, ptr, bytes.length).set(bytes)
    ex.demo_set_input(bytes.length)
  }

  function readResult() {
    const len = ex.demo_result_len()
    const ptr = ex.demo_result_ptr()
    return JSON.parse(new TextDecoder().decode(new Uint8Array(ex.memory.buffer, ptr, len)))
  }

  function esc(s) {
    const div = document.createElement('div')
    div.textContent = s ?? ''
    return div.innerHTML
  }

  const EVT_COLOR = {
    turn_start: 'evt-start',
    tool_call: 'evt-call',
    tool_result: 'evt-result',
    message_end: 'evt-msg',
    turn_end: 'evt-end'
  }

  function stagger(ol, items, render) {
    ol.innerHTML = ''
    items.forEach((item, i) => {
      const li = render(item)
      li.style.animationDelay = `${i * 60}ms`
      ol.appendChild(li)
    })
    if (!items.length) ol.innerHTML = '<li class="empty">（空）</li>'
  }

  function renderEvents(list) {
    stagger($('demo-events'), list, (ev) => {
      const li = document.createElement('li')
      li.dataset.evt = EVT_COLOR[ev.event] ?? ''
      li.innerHTML = `<i class="dot" /><span class="seq">#${ev.seq} </span><b>${esc(ev.event)}</b>${
        ev.count != null ? `<span class="meta">count=${ev.count}</span>` : ''
      }`
      return li
    })
  }

  function renderEntries(list) {
    stagger($('demo-entries'), list, (e) => {
      const li = document.createElement('li')
      const parent = e.parent_id ? `<span class="parent" title="${e.parent_id}">↤ ${e.parent_id.slice(0, 8)}</span>` : '<span class="parent root">root</span>'
      const detail =
        e.kind === 'user' || e.kind === 'assistant'
          ? esc(e.payload.content ?? '')
          : e.kind === 'tool_call'
            ? `<em>${esc(e.payload.name)}</em>(${esc(JSON.stringify(e.payload.args ?? {}))})`
            : esc(JSON.stringify(e.payload))
      li.innerHTML = `<span class="seq">#${e.seq} </span><span class="kind k-${e.kind}">${esc(e.kind)}</span><span class="author">${esc(e.author)}</span> ${parent} <span class="detail">${detail}</span>`
      return li
    })
  }

  function renderMessages(list) {
    stagger($('demo-messages'), list, (m) => {
      const li = document.createElement('li')
      const tool = m.tool_calls?.map((c) => `<em>${esc(c.name)}</em>(${esc(c.argsText ?? JSON.stringify(c.args ?? {}))})`).join(', ') ?? ''
      li.innerHTML = `<span class="role r-${esc(m.role)}">${esc(m.role)}</span><span class="mbody">${esc(m.content ?? '')}${tool ? ` <code>${tool}</code>` : ''}</span>`
      return li
    })
  }

  function renderRaw(result) {
    $('demo-raw').textContent = JSON.stringify(result, null, 2)
  }

  function runTurn() {
    if (!ex) return
    const text = $('demo-input').value
    if (!text.trim()) return
    setStatus('running…', true, true)
    writeInput(text)
    const code = ex.demo_prompt()
    if (code !== 0) {
      $('demo-raw').textContent = `demo_prompt 返回 ${code}（内存不足或状态未初始化）`
      setStatus('wasm 就绪 · 220 KB', true, false)
      return
    }
    const result = readResult()
    renderEvents(result.events)
    renderEntries(result.entries)
    renderMessages(result.messages)
    renderRaw(result)
    setStatus('wasm 就绪 · 220 KB', true, false)
  }

  function resumeDemo() {
    if (!ex) return
    const code = ex.demo_resume()
    if (code !== 0) {
      $('demo-raw').textContent = `demo_resume 返回 ${code}（请先运行一个 turn）`
      return
    }
    const result = readResult()
    renderEntries(result.entries)
    renderMessages(result.messages)
    $('demo-events').innerHTML = '<li class="empty">resume 不产生事件（重放日志重建）</li>'
    renderRaw(result)
  }

  function resetDemo() {
    if (!ex) return
    ex.demo_init()
    for (const id of ['demo-events', 'demo-entries', 'demo-messages']) {
      $(id).innerHTML = '<li class="empty">等待运行（点 ▶）</li>'
    }
    $('demo-raw').textContent = '—'
  }

  $('demo-run')?.addEventListener('click', runTurn)
  $('demo-resume')?.addEventListener('click', resumeDemo)
  $('demo-reset')?.addEventListener('click', resetDemo)
  loadWasm()
</script>

<style>
  /* ---- 深色"信号仪器"面板：在浅色书稿页上是醒目对比卡片，深色页也协调 ---- */
  .apeiron-demo {
    --ink: #0e1116;
    --panel: #141920;
    --panel-2: #1a202a;
    --line: #262f3b;
    --line-2: #303b4a;
    --txt: #e7eaee;
    --dim: #8a95a4;
    --amber: #f2b24d;
    --teal: #3ecfbe;
    --green: #53d98a;
    --blue: #7fa7f2;
    --violet: #b48af2;

    font-family: var(--font-sans, 'Satoshi', ui-sans-serif, system-ui, sans-serif);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 1.25rem 0;
    padding: 1.15rem 1.25rem 0.9rem;
    border-radius: 16px;
    background:
      radial-gradient(120% 90% at 12% -10%, rgba(63, 207, 190, 0.10), transparent 42%),
      radial-gradient(110% 80% at 95% -20%, rgba(242, 178, 77, 0.08), transparent 45%),
      var(--ink);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 24px 48px -32px rgba(0, 0, 0, 0.65),
      0 2px 10px -4px rgba(0, 0, 0, 0.4);
    color: var(--txt);
    position: relative;
    overflow: hidden;
  }
  .apeiron-demo::before {
    /* 顶部扫描线：仪表盘质感 */
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(63, 207, 190, 0.55), rgba(242, 178, 77, 0.45), transparent);
    opacity: 0.7;
  }

  /* header */
  .hd {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .hd-title {
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .hd-sub {
    margin-top: 2px;
    font-size: 0.78rem;
    color: var(--dim);
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    letter-spacing: 0.02em;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    flex: none;
    font-size: 0.72rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    color: var(--dim);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.22rem 0.65rem;
    background: rgba(0, 0, 0, 0.25);
  }
  .status .led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f26d5b;
    box-shadow: 0 0 6px rgba(242, 109, 91, 0.8);
  }
  .status[data-ok='1'] .led {
    background: var(--green);
    box-shadow: 0 0 8px rgba(83, 217, 138, 0.9);
  }
  .status[data-ok='0'] .led {
    background: #f26d5b;
  }
  .status.busy .led {
    background: var(--amber);
    animation: pulse 0.9s ease-in-out infinite;
  }
  @keyframes pulse {
    50% { transform: scale(1.6); opacity: 0.55; }
  }

  /* controls */
  .controls {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .inputwrap {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: #0a0d12;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .inputwrap:focus-within {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(63, 207, 190, 0.14);
  }
  .prompt {
    display: flex;
    align-items: center;
    padding: 0 0.7rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    font-size: 0.75rem;
    color: var(--amber);
    user-select: none;
    border-right: 1px solid var(--line);
  }
  #demo-input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--txt);
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    font-size: 0.85rem;
    padding: 0.72rem 0.8rem;
    resize: vertical;
    min-height: 2.6em;
  }
  #demo-input::placeholder {
    color: #55606e;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .actions button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: 9px;
    cursor: pointer;
    border: 1px solid var(--line-2);
    color: var(--txt);
    background: var(--panel-2);
    transition: transform 0.08s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .actions button:hover {
    border-color: #3d4a5c;
    background: #202836;
  }
  .actions button:active {
    transform: scale(0.97);
  }
  .actions .primary {
    background: linear-gradient(180deg, #ffc96b, var(--amber));
    color: #2a1a03;
    font-weight: 650;
    border: 1px solid #ffd88f;
    box-shadow: 0 6px 18px -8px rgba(242, 178, 77, 0.55);
  }
  .actions .primary:hover {
    background: linear-gradient(180deg, #ffd47f, #f7b64a);
  }
  .actions .primary .tri {
    font-size: 0.68em;
    margin-right: 0.35rem;
  }

  /* columns */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(228px, 1fr));
    gap: 0.8rem;
  }
  .col {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(9, 12, 17, 0.55);
    padding: 0.7rem 0.8rem 0.8rem;
    min-width: 0;
  }
  .col-h {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.55rem;
  }
  .tick {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    transform: rotate(45deg);
    flex: none;
  }
  .t-evt { background: var(--blue); }
  .t-log { background: var(--teal); }
  .t-msg { background: var(--violet); }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 15.5rem;
    overflow: auto;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .list li {
    opacity: 0;
    transform: translateY(4px);
    animation: rise 0.4s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
    padding: 0.28rem 0.35rem;
    border-radius: 6px;
    margin: 0 -0.35rem;
  }
  .list li:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  .empty {
    opacity: 0.55 !important;
    color: var(--dim);
    animation: none !important;
  }
  .seq {
    color: var(--teal);
    margin-right: 0.5rem;
    font-size: 0.74em;
    flex: none;
  }
  .meta {
    color: var(--dim);
    font-size: 0.9em;
    margin-left: 0.4rem;
  }

  /* events: timeline */
  .evt li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-left: 2px solid var(--line);
    margin-left: 0.35rem;
    padding-left: 0.55rem;
  }
  .evt .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.04);
  }
  .evt li.evt-start .dot { background: var(--blue); }
  .evt li.evt-call .dot { background: var(--amber); }
  .evt li.evt-result .dot { background: var(--green); }
  .evt li.evt-msg .dot { background: var(--violet); }
  .evt li.evt-end .dot { background: var(--dim); }
  .evt li b { font-weight: 600; }

  /* entries: tree */
  .log li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .log .kind {
    flex: none;
    font-size: 0.72em;
    font-weight: 600;
    padding: 0.05rem 0.4rem;
    border-radius: 5px;
    border: 1px solid var(--line-2);
  }
  .log .k-user { color: var(--blue); border-color: rgba(127, 167, 242, 0.35); }
  .log .k-assistant { color: var(--green); border-color: rgba(83, 217, 138, 0.35); }
  .log .k-tool_call { color: var(--amber); border-color: rgba(242, 178, 77, 0.35); }
  .log .k-tool_result { color: var(--teal); border-color: rgba(63, 207, 190, 0.35); }
  .log .k-summary, .log .k-checkpoint { color: var(--violet); border-color: rgba(180, 138, 242, 0.35); }
  .log .author {
    color: var(--dim);
    font-size: 0.72em;
    flex: none;
  }
  .log .parent {
    color: var(--dim);
    font-size: 0.72em;
    flex: none;
  }
  .log .parent.root {
    color: #5a6575;
  }
  .log .detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #c9d1dc;
  }
  .log .detail em { font-style: normal; color: var(--amber); }

  /* messages: role stream */
  .msg li {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
  }
  .role {
    flex: none;
    font-size: 0.68em;
    font-weight: 700;
    padding: 0.06rem 0.45rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .r-user { background: rgba(127, 167, 242, 0.16); color: var(--blue); }
  .r-assistant { background: rgba(83, 217, 138, 0.16); color: var(--green); }
  .r-tool { background: rgba(242, 178, 77, 0.16); color: var(--amber); }
  .mbody { color: #cdd5e0; word-break: break-word; }
  .mbody code {
    font-family: inherit;
    color: var(--teal);
  }

  /* raw drawer */
  .raw {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: #0a0d12;
  }
  .raw summary {
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    user-select: none;
  }
  .raw summary::-webkit-details-marker { display: none; }
  .raw summary::before {
    content: '▸ ';
    color: var(--amber);
  }
  .raw[open] summary::before {
    content: '▾ ';
  }
  .raw pre {
    margin: 0;
    border-top: 1px solid var(--line);
    padding: 0.7rem 0.8rem;
    max-height: 17rem;
    overflow: auto;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    font-size: 0.74rem;
    line-height: 1.55;
    color: #b9c3d0;
  }

  /* footer */
  .ft {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 0.15rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5a6575;
  }
  .ft-dots {
    color: var(--teal);
    letter-spacing: 0.3em;
  }
</style>
